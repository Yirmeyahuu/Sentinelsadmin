# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.so
*.dll
*.pyd

# Virtual environments
venv/
env/
virt/

# Django database and settings (if sensitive)
*.sqlite3
db.sqlite3
config/settings.py

# IDE/editor files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Node and frontend build artifacts
node_modules/
dist/

# MacOS and system files
.DS_Store
Thumbs.db

# Log files
*.log

# Package files
*.jar
*.war
*.zip
*.tar.gz

# Test reports
TEST*.xml

# Media and large files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Firebase credentials and secrets
sentinels-a61ff-firebase-adminsdk-fbsvc-aaf9572a3f.json
*.json

# Static and media files (uncomment if you build them)
# static/
# media/

# Python egg files
*.egg-info/
.eggs/

# Coverage reports
htmlcov/
.coverage

# Jupyter Notebooks
*.ipynb

# Backup files
*~
*.bak

# VS Code settings
.settings/

# Tailwind and build cache
.cache/

# Misc
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore screenshots if not needed
# screenshots/
